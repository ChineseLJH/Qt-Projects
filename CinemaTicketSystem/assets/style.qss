/* =========================================
   全局基础属性初始化
   ========================================= */
QWidget {
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
}

/* =========================================
   页面级容器底层背景
   使用对象 ID 选择器精准映射到特定实例
   ========================================= */
#homeView, #movieListView, #seatSelectionView, #checkoutView {
    background-color: #181C24; /* 深空黑灰，提升沉浸感 */
}

/* =========================================
   主页专属组件映射
   ========================================= */
#mainTitleLabel {
    color: #F8F9FA;
    font-size: 52px;
    font-weight: 800;
    letter-spacing: 12px;
    background: transparent; /* 强制清空级联污染的背景 */
}

#startBtn {
    /* 采用显卡加速的线性渐变色填充寄存器 */
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #FF416C, stop:1 #FF4B2B);
    color: #FFFFFF;
    font-size: 24px;
    font-weight: bold;
    border-radius: 30px; /* 开启底层抗锯齿圆角计算 */
    border: none;
}

/* 拦截鼠标悬浮中断，重绘指令 */
#startBtn:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #FF4B2B, stop:1 #FF416C);
}

/* 拦截鼠标按下中断，重绘指令 */
#startBtn:pressed {
    background-color: #D93838;
}

/* 卡片外部容器 */
QFrame#movieCard {
    background-color: #2C3E50;
    border-radius: 12px;
    border: 1px solid #34495E;
}

/* 强制清除卡片内部所有标签的背景与边框，防止级联污染 */
QFrame#movieCard QLabel {
    border: none;
    background: transparent;
}

/* 电影标题 */
QLabel#movieTitle {
    color: #ECF0F1;
    font-size: 22px;
    font-weight: bold;
}

/* 电影详情参数 */
QLabel#movieDetail {
    color: #BDC3C7;
    font-size: 14px;
}

/* 座位状态标签 - 默认状态（空闲、有票）显式指定绿色 */
QLabel#movieSeat {
    font-size: 14px;
    font-weight: bold;
    color: #2ECC71; 
}

/* 座位状态标签 - 当动态属性 isFull 为 true 时，底层重绘为红色 */
QLabel#movieSeat[isFull="true"] {
    color: #E74C3C;
}

/* 购票按钮 */
QPushButton#movieBookBtn {
    background-color: #E67E22;
    color: white;
    font-size: 16px;
    font-weight: bold;
    border-radius: 6px;
    border: none;
}

QPushButton#movieBookBtn:hover {
    background-color: #D35400;
}

QPushButton#movieBookBtn:pressed {
    background-color: #A04000;
}

QPushButton#btnBack {
    background-color: transparent;
    color: #BDC3C7;
    font-size: 16px;
    border: 1px solid #7F8C8D;
    border-radius: 4px;
}
QPushButton#btnBack:hover {
    background-color: #34495E;
    color: white;
}
QPushButton#btnSmart {
    background-color: #8E44AD;
    color: white;
    font-size: 16px;
    font-weight: bold;
    border-radius: 4px;
}
QPushButton#btnSmart:hover { background-color: #9B59B6; }